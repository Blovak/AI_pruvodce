# Nikdy tento soubor nenahrazujte skutečným klíčem v Gitu.
DEEPSEEK_API_KEY=sk-...

# Volitelné: model lze změnit bez zásahu do kódu.
DEEPSEEK_MODEL=deepseek-v4-flash

# Volitelné: anonymizovaný provozní log do Google Sheets.
GOOGLE_LOG_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_LOG_TOKEN=replace-with-a-long-random-secret

# Firestore je po vyplnění všech hodnot primární úložiště autentizace, cache a
# analytiky. Privátní klíč ponechte na jednom řádku s escapovanými \n.
FIREBASE_PROJECT_ID=mistopis-project-id
FIREBASE_CLIENT_EMAIL=mistopis-server@mistopis-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Migrační nástroj může místo tří hodnot výše načíst stažený JSON soubor.
# Soubor je ignorovaný Gitem a slouží pouze pro jednorázovou migraci.
FIREBASE_SERVICE_ACCOUNT_FILE=.firebase-service-account.json

# Musí být shodný s AUTH_SECRET ve vlastnostech stávajícího Apps Scriptu,
# aby po migraci zůstaly platné existující 180denní relace.
AUTH_SECRET=replace-with-the-existing-apps-script-auth-secret

# Apps Script po migraci dál asynchronně zapisuje analytiku do Google Sheets a
# odesílá OTP e-maily. Databázové operace obsluhuje Firestore.
