# Nikdy tento soubor nenahrazujte skutečným klíčem v Gitu.
OPENAI_API_KEY=sk-proj-...

# Volitelné: modely lze změnit bez zásahu do kódu.
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Volitelné: anonymizovaný provozní log do Google Sheets.
GOOGLE_LOG_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GOOGLE_LOG_TOKEN=replace-with-a-long-random-secret
